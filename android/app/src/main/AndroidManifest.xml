<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Van's whole premise is a notification arriving at a chosen minute, so
         `AndroidScheduleMode.exactAllowWhileIdle` in lib/platform/notifications.dart
         is not a nicety. On API 31+ that mode needs this permission; without it
         zonedSchedule throws, registers nothing with AlarmManager, and no nudge
         ever fires. It is user-revocable, which is why schedule() falls back to
         an inexact alarm rather than losing the rung entirely. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- A pre-scheduled ladder is armed once and must survive a restart.
         Without this every rung is silently dropped on reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- A planner that schedules you into a meeting you already agreed to is
         wrong, not merely limited. Van reads the device calendar at plan time
         and never writes to it, so there is no matching WRITE_CALENDAR here
         and there should not be. Requested at runtime; a refusal degrades
         planning to Van's own sessions rather than failing anything. -->
    <uses-permission android:name="android.permission.READ_CALENDAR"/>
    <!-- Typing is the thing standing between "I should do that" and Van
         knowing about it. Requested at runtime, and refusing it hides the
         microphone button rather than breaking anything.

         Audio never leaves this device: SpeechPlugin.kt uses
         createOnDeviceSpeechRecognizer and has no fallback to the networked
         recogniser, which is why there is no INTERNET permission here and
         must never be one. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Android 11+ package visibility: without this, a query for the
         on-device recogniser cannot see the service that provides it and
         isOnDeviceRecognitionAvailable answers false on a phone that can. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- So the model page can be handed to a browser. Van makes no
             request itself and has no HTTP client; this is package
             visibility for an ACTION_VIEW, which Android 11+ hides without
             a declaration. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
    <application
        android:label="Van"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
